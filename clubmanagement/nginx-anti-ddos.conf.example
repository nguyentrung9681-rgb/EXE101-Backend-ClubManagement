# =========================================================================
# Cấu hình Mẫu Nginx Chống DoS / DDoS & Giới Hạn Tần Suất Truy Cập (Rate Limit)
# =========================================================================

# 1. Định nghĩa các vùng nhớ lưu trữ Rate Limit per Client IP (Layer 7 Anti-DoS)
# -------------------------------------------------------------------------
# Giới hạn request chung: tối đa 30 request/phút per IP
limit_req_zone $binary_remote_addr zone=general_limit:10m rate=30r/m;

# Giới hạn kết nối đồng thời: tối đa 10 kết nối active per IP
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# Giới hạn riêng cho API Đăng nhập/Đăng ký: tối đa 10 request/phút
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;


server {
    listen 80;
    server_name yourdomain.com;

    # Redirect HTTP -> HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name yourdomain.com;

    # SSL Certificate Config...

    # 2. Cấu hình Timeout chống tấn công Slowloris (Giữ kết nối mở vô hạn)
    # -------------------------------------------------------------------------
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 10s;

    # Giới hạn dung lượng Request Body tối đa (Chống DoS upload file lớn)
    client_max_body_size 10M;

    # 3. Chuyển tiếp Header thực từ Cloudflare / Proxy
    # -------------------------------------------------------------------------
    set_real_ip_from 0.0.0.0/0;
    real_ip_header CF-Connecting-IP; # Sử dụng X-Forwarded-For nếu không dùng Cloudflare

    # 4. Proxy cấu hình cho API Đăng Nhập / Authentication (Rate Limit nghiêm ngặt)
    # -------------------------------------------------------------------------
    location /api/auth/ {
        limit_req zone=auth_limit burst=5 nodelay;
        limit_conn conn_limit 5;

        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 5. Proxy cấu hình chung cho các API còn lại
    # -------------------------------------------------------------------------
    location / {
        limit_req zone=general_limit burst=20 nodelay;
        limit_conn conn_limit 10;

        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
