# Server Config
PORT=8080

# Spring Database Config
DB_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.szeegfcwnfkbgybdszga
DB_PASSWORD=your_db_password

# Google OAuth2 Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# PayOS Config (bat buoc phai la key THAT o production - thieu key thi tao checkout se bi tu choi)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Chi bat true khi dev local:
# - PAYOS_ALLOW_UNCONFIGURED_CHECKOUT: tao don hang voi QR gia khi chua co key PayOS
# - PAYOS_MANUAL_CONFIRM_ENABLED: mo endpoint POST /api/payments/order/{code}/confirm-test
PAYOS_ALLOW_UNCONFIGURED_CHECKOUT=true
PAYOS_MANUAL_CONFIRM_ENABLED=true

# Trello Config
TRELLO_API_KEY=your_trello_api_key
TRELLO_REDIRECT_URI=https://exe-ebon.vercel.app/api/trello/callback

# Frontend URL Config
# FRONTEND_URL du: backend tu noi ra URL OAuth redirect, PayOS return/cancel va Calendar tu day.
FRONTEND_URL=https://exe-ebon.vercel.app
FRONTEND_CALENDAR_URL=https://exe-ebon.vercel.app/calendar
FRONTEND_TRELLO_URL=https://exe-ebon.vercel.app/api/trello/callback
FRONTEND_REDIRECT_URL=https://exe-ebon.vercel.app
# Chi dat 2 cai nay neu muon khac FRONTEND_URL
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Spring Mail Config (Gmail App Password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Email API providers (uu tien khi gui: Mailjet -> Brevo -> Resend -> SMTP o tren)
# Chi can dien 1 cai. Thieu ca 4 cai thi email hoa don se KHONG duoc gui (loi log ERROR).
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_SENDER_EMAIL=noreply@your-domain.vn
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Danh sach email duoc cap ROLE_ADMIN (ngua cache, viet lieu nhau).
# Ai khong nam trong danh sach nay se bi chan khi goi /api/admin/**
APP_ADMIN_EMAILS=admin1@example.com,admin2@example.com

